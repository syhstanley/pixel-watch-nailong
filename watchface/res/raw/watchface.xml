<?xml version="1.0" encoding="utf-8"?>
<!--
  Nailong Pixel Watch Face — v2.3 (WFF v2)
  - Pixel-aligned Pixel Watch "Utility" layout with DM Sans Bold (SIL OFL)
  - Dynamic Nailong Size selector in Watch Face Editor:
    Small (0.85x), Medium (1x), Large (1.35x), XL (1.65x), Giant (2x, default), Hidden
  - Size-aware circular boundary clamping so Nailong never crosses the bezel even at 2x
  - Real-hardware calibrated tilt (+ANGLE_X right, +ANGLE_Y down), 25-deg dead zone, steady LINEAR walk
-->
<WatchFace width="450" height="450">

    <Metadata key="PREVIEW_TIME" value="22:55:00" />
    <Metadata key="CLOCK_TYPE" value="DIGITAL" />

    <UserConfigurations>
        <ListConfiguration id="nailongLayer" displayName="config_layer_name" defaultValue="behind">
            <ListOption id="behind" displayName="config_layer_behind" />
            <ListOption id="front" displayName="config_layer_front" />
        </ListConfiguration>

        <ListConfiguration id="nailongHome" displayName="config_home_name" defaultValue="top_right">
            <ListOption id="top_right" displayName="config_home_top_right" />
            <ListOption id="center" displayName="config_home_center" />
            <ListOption id="top_left" displayName="config_home_top_left" />
            <ListOption id="bottom" displayName="config_home_bottom" />
        </ListConfiguration>

        <ListConfiguration id="nailongSize" displayName="config_size_name" defaultValue="giant">
            <ListOption id="small" displayName="config_size_small" />
            <ListOption id="medium" displayName="config_size_medium" />
            <ListOption id="large" displayName="config_size_large" />
            <ListOption id="xl" displayName="config_size_xl" />
            <ListOption id="giant" displayName="config_size_giant" />
            <ListOption id="off" displayName="config_size_off" />
        </ListConfiguration>
    </UserConfigurations>

    <Scene backgroundColor="#FF000000">

        <!-- ============================================================ -->
        <!-- NAILONG LAYER: BEHIND CLOCK (Default)                        -->
        <!-- ============================================================ -->
        <ListConfiguration id="nailongLayer">
            <ListOption id="behind">
                <Group name="nailongBehindRoot" x="0" y="0" width="450" height="450">
                    <Variant mode="AMBIENT" target="alpha" value="0" />

                    <Group name="nailongBehindMover" x="249" y="83" width="120" height="120" pivotX="0.5" pivotY="0.5">
                        <Transform target="x" value="165 + (([ACCELEROMETER_ANGLE_X] &gt; 25 || [ACCELEROMETER_ANGLE_X] &lt; -25 || [ACCELEROMETER_ANGLE_Y] &gt; 25 || [ACCELEROMETER_ANGLE_Y] &lt; -25) ? (([ACCELEROMETER_ANGLE_X] &gt; 25 ? 1 : ([ACCELEROMETER_ANGLE_X] &lt; -25 ? -1 : 0)) * ((([ACCELEROMETER_ANGLE_X] &gt; 25 || [ACCELEROMETER_ANGLE_X] &lt; -25) &amp;&amp; ([ACCELEROMETER_ANGLE_Y] &gt; 25 || [ACCELEROMETER_ANGLE_Y] &lt; -25)) ? ([CONFIGURATION.nailongSize] == &quot;small&quot; ? 107 : ([CONFIGURATION.nailongSize] == &quot;medium&quot; ? 102 : ([CONFIGURATION.nailongSize] == &quot;large&quot; ? 92 : ([CONFIGURATION.nailongSize] == &quot;xl&quot; ? 82 : 72)))) : ([CONFIGURATION.nailongSize] == &quot;small&quot; ? 152 : ([CONFIGURATION.nailongSize] == &quot;medium&quot; ? 144 : ([CONFIGURATION.nailongSize] == &quot;large&quot; ? 130 : ([CONFIGURATION.nailongSize] == &quot;xl&quot; ? 116 : 102)))))) : (([CONFIGURATION.nailongHome] == &quot;top_right&quot; ? 116 : ([CONFIGURATION.nailongHome] == &quot;top_left&quot; ? -116 : 0)) * ([CONFIGURATION.nailongSize] == &quot;giant&quot; ? 0.72 : ([CONFIGURATION.nailongSize] == &quot;xl&quot; ? 0.84 : ([CONFIGURATION.nailongSize] == &quot;large&quot; ? 0.92 : 1.0)))))">
                            <Animation duration="1.3" interpolation="LINEAR" fps="30" />
                        </Transform>
                        <Transform target="y" value="165 + (([ACCELEROMETER_ANGLE_X] &gt; 25 || [ACCELEROMETER_ANGLE_X] &lt; -25 || [ACCELEROMETER_ANGLE_Y] &gt; 25 || [ACCELEROMETER_ANGLE_Y] &lt; -25) ? (([ACCELEROMETER_ANGLE_Y] &gt; 25 ? 1 : ([ACCELEROMETER_ANGLE_Y] &lt; -25 ? -1 : 0)) * ((([ACCELEROMETER_ANGLE_X] &gt; 25 || [ACCELEROMETER_ANGLE_X] &lt; -25) &amp;&amp; ([ACCELEROMETER_ANGLE_Y] &gt; 25 || [ACCELEROMETER_ANGLE_Y] &lt; -25)) ? ([CONFIGURATION.nailongSize] == &quot;small&quot; ? 107 : ([CONFIGURATION.nailongSize] == &quot;medium&quot; ? 102 : ([CONFIGURATION.nailongSize] == &quot;large&quot; ? 92 : ([CONFIGURATION.nailongSize] == &quot;xl&quot; ? 82 : 72)))) : ([CONFIGURATION.nailongSize] == &quot;small&quot; ? 152 : ([CONFIGURATION.nailongSize] == &quot;medium&quot; ? 144 : ([CONFIGURATION.nailongSize] == &quot;large&quot; ? 130 : ([CONFIGURATION.nailongSize] == &quot;xl&quot; ? 116 : 102)))))) : (([CONFIGURATION.nailongHome] == &quot;bottom&quot; ? 142 : ([CONFIGURATION.nailongHome] == &quot;center&quot; ? 0 : -114)) * ([CONFIGURATION.nailongSize] == &quot;giant&quot; ? 0.72 : ([CONFIGURATION.nailongSize] == &quot;xl&quot; ? 0.84 : ([CONFIGURATION.nailongSize] == &quot;large&quot; ? 0.92 : 1.0)))))">
                            <Animation duration="1.3" interpolation="LINEAR" fps="30" />
                        </Transform>
                        <Transform target="angle" value="([ACCELEROMETER_ANGLE_X] &gt; 25 ? 8 : ([ACCELEROMETER_ANGLE_X] &lt; -25 ? -8 : 0))">
                            <Animation duration="0.35" interpolation="EASE_OUT" fps="30" />
                        </Transform>
                        <Transform target="scaleX" value="([CONFIGURATION.nailongSize] == &quot;small&quot; ? 0.85 : ([CONFIGURATION.nailongSize] == &quot;medium&quot; ? 1.0 : ([CONFIGURATION.nailongSize] == &quot;large&quot; ? 1.35 : ([CONFIGURATION.nailongSize] == &quot;xl&quot; ? 1.65 : ([CONFIGURATION.nailongSize] == &quot;off&quot; ? 0.0 : 2.0)))))" />
                        <Transform target="scaleY" value="([CONFIGURATION.nailongSize] == &quot;small&quot; ? 0.85 : ([CONFIGURATION.nailongSize] == &quot;medium&quot; ? 1.0 : ([CONFIGURATION.nailongSize] == &quot;large&quot; ? 1.35 : ([CONFIGURATION.nailongSize] == &quot;xl&quot; ? 1.65 : ([CONFIGURATION.nailongSize] == &quot;off&quot; ? 0.0 : 2.0)))))" />

                        <!-- Nailong sprite (crisp 192x192 source, dynamically scaled 0.85x..2.0x) -->
                        <Condition>
                            <Expressions>
                                <Expression name="steepTopRightBehind"><![CDATA[([ACCELEROMETER_ANGLE_X] > 25 && [ACCELEROMETER_ANGLE_Y] < -25)]]></Expression>
                                <Expression name="steepTopLeftBehind"><![CDATA[([ACCELEROMETER_ANGLE_X] < -25 && [ACCELEROMETER_ANGLE_Y] < -25)]]></Expression>
                                <Expression name="runRightBehind"><![CDATA[([ACCELEROMETER_ANGLE_X] > 25 || [ACCELEROMETER_ANGLE_Y] > 25 || [ACCELEROMETER_ANGLE_Y] < -25)]]></Expression>
                                <Expression name="runLeftBehind"><![CDATA[[ACCELEROMETER_ANGLE_X] < -25]]></Expression>
                                <Expression name="holdNotifFlatBehind"><![CDATA[[UNREAD_NOTIFICATION_COUNT] > 0]]></Expression>
                            </Expressions>

                            <Compare expression="steepTopRightBehind">
                                <PartAnimatedImage x="14" y="14" width="92" height="92" name="nlBehindTopRight">
                                    <AnimationController play="ON_VISIBLE" repeat="TRUE" />
                                    <AnimatedImage resource="nailong_top_right_anim" format="WEBP" thumbnail="nailong_top_right_thumb" />
                                    <Thumbnail resource="nailong_top_right_thumb" />
                                </PartAnimatedImage>
                            </Compare>

                            <Compare expression="steepTopLeftBehind">
                                <PartAnimatedImage x="14" y="14" width="92" height="92" name="nlBehindTopLeft">
                                    <AnimationController play="ON_VISIBLE" repeat="TRUE" />
                                    <AnimatedImage resource="nailong_top_left_anim" format="WEBP" thumbnail="nailong_top_left_thumb" />
                                    <Thumbnail resource="nailong_top_left_thumb" />
                                </PartAnimatedImage>
                            </Compare>

                            <Compare expression="runLeftBehind">
                                <PartAnimatedImage x="14" y="14" width="92" height="92" name="nlBehindRunLeft">
                                    <AnimationController play="ON_VISIBLE" repeat="TRUE" />
                                    <AnimatedImage resource="nailong_run_left_anim" format="WEBP" thumbnail="nailong_run_left_thumb" />
                                    <Thumbnail resource="nailong_run_left_thumb" />
                                </PartAnimatedImage>
                            </Compare>

                            <Compare expression="runRightBehind">
                                <PartAnimatedImage x="14" y="14" width="92" height="92" name="nlBehindRunRight">
                                    <AnimationController play="ON_VISIBLE" repeat="TRUE" />
                                    <AnimatedImage resource="nailong_run_right_anim" format="WEBP" thumbnail="nailong_run_right_thumb" />
                                    <Thumbnail resource="nailong_run_right_thumb" />
                                </PartAnimatedImage>
                            </Compare>

                            <Compare expression="holdNotifFlatBehind">
                                <PartAnimatedImage x="14" y="14" width="92" height="92" name="nlBehindHoldNotif">
                                    <AnimationController play="ON_VISIBLE" repeat="TRUE" delayRepeat="0.8" />
                                    <AnimatedImage resource="nailong_wave_anim" format="WEBP" thumbnail="nailong_wave_thumb" />
                                    <Thumbnail resource="nailong_wave_thumb" />
                                </PartAnimatedImage>
                            </Compare>

                            <Default>
                                <PartAnimatedImage x="14" y="14" width="92" height="92" name="nlBehindIdle">
                                    <AnimationController play="ON_VISIBLE TAP" repeat="TRUE" delayRepeat="0.3" />
                                    <AnimatedImages change="TAP">
                                        <AnimatedImage resource="nailong_idle_anim" format="WEBP" thumbnail="nailong_idle_thumb" />
                                        <AnimatedImage resource="nailong_check_anim" format="WEBP" thumbnail="nailong_check_thumb" />
                                        <AnimatedImage resource="nailong_wave_anim" format="WEBP" thumbnail="nailong_wave_thumb" />
                                        <AnimatedImage resource="nailong_think_anim" format="WEBP" thumbnail="nailong_think_thumb" />
                                    </AnimatedImages>
                                    <Thumbnail resource="nailong_idle_thumb" />
                                </PartAnimatedImage>
                            </Default>
                        </Condition>

                        <!-- Style-aligned notification badge (counter-scaled cleanly across all Nailong sizes) -->
                        <Condition>
                            <Expressions>
                                <Expression name="hasNotifBehind"><![CDATA[[UNREAD_NOTIFICATION_COUNT] > 0]]></Expression>
                            </Expressions>
                            <Compare expression="hasNotifBehind">
                                <Group name="nlBehindNotifBadge" x="6" y="22" width="30" height="30" pivotX="0.5" pivotY="0.5">
                                    <Transform target="x" value="([ACCELEROMETER_ANGLE_X] &gt; 25 ? 84 : 6)">
                                        <Animation duration="0.25" interpolation="EASE_OUT" fps="30" />
                                    </Transform>
                                    <Transform target="y" value="(([ACCELEROMETER_ANGLE_Y] &lt; -25 &amp;&amp; ([ACCELEROMETER_ANGLE_X] &gt; 25 || [ACCELEROMETER_ANGLE_X] &lt; -25)) ? 14 : (([ACCELEROMETER_ANGLE_X] &gt; 25 || [ACCELEROMETER_ANGLE_X] &lt; -25 || [ACCELEROMETER_ANGLE_Y] &gt; 25 || [ACCELEROMETER_ANGLE_Y] &lt; -25) ? 28 : 22))">
                                        <Animation duration="0.25" interpolation="EASE_OUT" fps="30" />
                                    </Transform>
                                    <Transform target="scaleX" value="([CONFIGURATION.nailongSize] == &quot;giant&quot; ? 0.62 : ([CONFIGURATION.nailongSize] == &quot;xl&quot; ? 0.72 : ([CONFIGURATION.nailongSize] == &quot;large&quot; ? 0.85 : 1.0)))" />
                                    <Transform target="scaleY" value="([CONFIGURATION.nailongSize] == &quot;giant&quot; ? 0.62 : ([CONFIGURATION.nailongSize] == &quot;xl&quot; ? 0.72 : ([CONFIGURATION.nailongSize] == &quot;large&quot; ? 0.85 : 1.0)))" />
                                    <PartDraw x="0" y="0" width="30" height="30">
                                        <Ellipse x="2" y="2" width="26" height="26">
                                            <Fill color="#F21C2110" />
                                        </Ellipse>
                                        <Ellipse x="2" y="2" width="26" height="26">
                                            <Stroke color="#FFE8F553" thickness="2.6" />
                                        </Ellipse>
                                    </PartDraw>
                                    <Condition>
                                        <Expressions>
                                            <Expression name="notifOver99Behind"><![CDATA[[UNREAD_NOTIFICATION_COUNT] > 99]]></Expression>
                                        </Expressions>
                                        <Compare expression="notifOver99Behind">
                                            <PartText x="1" y="7" width="28" height="18">
                                                <Text align="CENTER" maxLines="1">
                                                    <Font family="utility_bold" size="11" weight="BOLD" color="#FFFFFFFF">99+</Font>
                                                </Text>
                                            </PartText>
                                        </Compare>
                                        <Default>
                                            <PartText x="1" y="4" width="28" height="22">
                                                <Text align="CENTER" maxLines="1">
                                                    <Font family="utility_bold" size="15" weight="BOLD" color="#FFFFFFFF">
                                                        <Template><![CDATA[%d]]><Parameter expression="[UNREAD_NOTIFICATION_COUNT]" /></Template>
                                                    </Font>
                                                </Text>
                                            </PartText>
                                        </Default>
                                    </Condition>
                                </Group>
                            </Compare>
                        </Condition>
                    </Group>
                </Group>
            </ListOption>
        </ListConfiguration>

        <!-- ============================================================ -->
        <!-- UTILITY DATE HEADER: Pixel-aligned "WED NOV 25"              -->
        <!-- ============================================================ -->
        <PartText x="45" y="48" width="360" height="42" name="dateHeader">
            <Variant mode="AMBIENT" target="alpha" value="145" />
            <Text align="CENTER">
                <Font family="utility_bold" size="29" weight="BOLD" color="#FFE8F553">
                    <Upper>
                        <Template><![CDATA[%s ]]><Parameter expression="[DAY_OF_WEEK_S]" /></Template>
                    </Upper>
                </Font>
                <Font family="utility_bold" size="29" weight="BOLD" color="#FFFFFFFF">
                    <Upper>
                        <Template><![CDATA[%s %d]]><Parameter expression="[MONTH_S]" /><Parameter expression="[DAY]" /></Template>
                    </Upper>
                </Font>
            </Text>
        </PartText>

        <!-- ============================================================ -->
        <!-- UTILITY 24-HOUR DIGITAL CLOCK: Pixel-aligned 124px "22:55"   -->
        <!-- ============================================================ -->
        <DigitalClock x="15" y="92" width="420" height="154">
            <TimeText format="hh:mm" hourFormat="24" align="CENTER" x="0" y="0" width="420" height="154">
                <Variant mode="AMBIENT" target="alpha" value="145" />
                <Font family="utility_bold" size="124" weight="BOLD" color="#FFE8F553" />
            </TimeText>
        </DigitalClock>

        <!-- ============================================================ -->
        <!-- UTILITY 3 CIRCULAR METRIC WIDGETS (100x100 at x=43, 175, 307)-->
        <!-- ============================================================ -->
        <Group name="metricsRow" x="0" y="254" width="450" height="108">
            <Variant mode="AMBIENT" target="alpha" value="0" />

            <!-- 1. STEPS CIRCLE (Left: x=43..143, center=93) -->
            <Group name="stepsWidget" x="43" y="2" width="100" height="100">
                <PartDraw x="0" y="0" width="100" height="100">
                    <Ellipse x="0" y="0" width="100" height="100">
                        <Fill color="#CC242814" />
                    </Ellipse>
                    <Arc centerX="50" centerY="50" width="88" height="88" startAngle="-145" endAngle="145" direction="CLOCKWISE">
                        <Stroke color="#FF3B421D" thickness="9.5" cap="ROUND" />
                    </Arc>
                    <Arc centerX="50" centerY="50" width="88" height="88" startAngle="-145" endAngle="-145" direction="CLOCKWISE">
                        <Transform target="endAngle" value="-145 + clamp([STEP_PERCENT], 0, 100) * 2.9">
                            <Animation duration="0.4" interpolation="EASE_OUT" />
                        </Transform>
                        <Stroke color="#FFE8F553" thickness="9.5" cap="ROUND" />
                    </Arc>
                </PartDraw>
                <PartText x="8" y="31" width="84" height="34">
                    <Text align="CENTER" maxLines="1">
                        <Font family="utility_bold" size="24" weight="BOLD" color="#FFFFFFFF">
                            <Template><![CDATA[%d]]><Parameter expression="[STEP_COUNT]" /></Template>
                        </Font>
                    </Text>
                </PartText>
                <PartImage x="39" y="76" width="22" height="22">
                    <Image resource="ic_steps" />
                </PartImage>
            </Group>

            <!-- 2. BATTERY CIRCLE (Center: x=175..275, center=225) -->
            <Group name="batteryWidget" x="175" y="2" width="100" height="100">
                <PartDraw x="0" y="0" width="100" height="100">
                    <Ellipse x="0" y="0" width="100" height="100">
                        <Fill color="#CC242814" />
                    </Ellipse>
                    <Arc centerX="50" centerY="50" width="88" height="88" startAngle="-145" endAngle="145" direction="CLOCKWISE">
                        <Stroke color="#FF3B421D" thickness="9.5" cap="ROUND" />
                    </Arc>
                    <Arc centerX="50" centerY="50" width="88" height="88" startAngle="-145" endAngle="-145" direction="CLOCKWISE">
                        <Transform target="endAngle" value="-145 + clamp([BATTERY_PERCENT], 0, 100) * 2.9">
                            <Animation duration="0.4" interpolation="EASE_OUT" />
                        </Transform>
                        <Stroke color="#FFE8F553" thickness="9.5" cap="ROUND" />
                    </Arc>
                </PartDraw>
                <PartText x="10" y="31" width="80" height="34">
                    <Text align="CENTER" maxLines="1">
                        <Font family="utility_bold" size="26" weight="BOLD" color="#FFFFFFFF">
                            <Template><![CDATA[%d]]><Parameter expression="[BATTERY_PERCENT]" /></Template>
                        </Font>
                    </Text>
                </PartText>
                <PartImage x="40" y="76" width="20" height="20">
                    <Image resource="ic_battery" />
                </PartImage>
            </Group>

            <!-- 3. HEART RATE CIRCLE (Right: x=307..407, center=357) -->
            <Group name="heartRateWidget" x="307" y="2" width="100" height="100">
                <PartDraw x="0" y="0" width="100" height="100">
                    <Ellipse x="0" y="0" width="100" height="100">
                        <Fill color="#CC242814" />
                    </Ellipse>
                </PartDraw>
                <PartImage x="38" y="20" width="24" height="24">
                    <Image resource="ic_heart" />
                </PartImage>
                <Condition>
                    <Expressions>
                        <Expression name="hasHr"><![CDATA[[HEART_RATE] > 0]]></Expression>
                    </Expressions>
                    <Compare expression="hasHr">
                        <PartText x="8" y="48" width="84" height="34">
                            <Text align="CENTER" maxLines="1">
                                <Font family="utility_bold" size="26" weight="BOLD" color="#FFFFFFFF">
                                    <Template><![CDATA[%d]]><Parameter expression="round([HEART_RATE])" /></Template>
                                </Font>
                            </Text>
                        </PartText>
                    </Compare>
                    <Default>
                        <PartText x="8" y="48" width="84" height="34">
                            <Text align="CENTER" maxLines="1">
                                <Font family="utility_bold" size="26" weight="BOLD" color="#FFFFFFFF">--</Font>
                            </Text>
                        </PartText>
                    </Default>
                </Condition>
            </Group>
        </Group>

        <!-- ============================================================ -->
        <!-- NAILONG LAYER: IN FRONT OF CLOCK (Optional Customize Toggle) -->
        <!-- ============================================================ -->
        <ListConfiguration id="nailongLayer">
            <ListOption id="front">
                <Group name="nailongFrontRoot" x="0" y="0" width="450" height="450">
                    <Variant mode="AMBIENT" target="alpha" value="0" />

                    <Group name="nailongFrontMover" x="249" y="83" width="120" height="120" pivotX="0.5" pivotY="0.5">
                        <Transform target="x" value="165 + (([ACCELEROMETER_ANGLE_X] &gt; 25 || [ACCELEROMETER_ANGLE_X] &lt; -25 || [ACCELEROMETER_ANGLE_Y] &gt; 25 || [ACCELEROMETER_ANGLE_Y] &lt; -25) ? (([ACCELEROMETER_ANGLE_X] &gt; 25 ? 1 : ([ACCELEROMETER_ANGLE_X] &lt; -25 ? -1 : 0)) * ((([ACCELEROMETER_ANGLE_X] &gt; 25 || [ACCELEROMETER_ANGLE_X] &lt; -25) &amp;&amp; ([ACCELEROMETER_ANGLE_Y] &gt; 25 || [ACCELEROMETER_ANGLE_Y] &lt; -25)) ? ([CONFIGURATION.nailongSize] == &quot;small&quot; ? 107 : ([CONFIGURATION.nailongSize] == &quot;medium&quot; ? 102 : ([CONFIGURATION.nailongSize] == &quot;large&quot; ? 92 : ([CONFIGURATION.nailongSize] == &quot;xl&quot; ? 82 : 72)))) : ([CONFIGURATION.nailongSize] == &quot;small&quot; ? 152 : ([CONFIGURATION.nailongSize] == &quot;medium&quot; ? 144 : ([CONFIGURATION.nailongSize] == &quot;large&quot; ? 130 : ([CONFIGURATION.nailongSize] == &quot;xl&quot; ? 116 : 102)))))) : (([CONFIGURATION.nailongHome] == &quot;top_right&quot; ? 116 : ([CONFIGURATION.nailongHome] == &quot;top_left&quot; ? -116 : 0)) * ([CONFIGURATION.nailongSize] == &quot;giant&quot; ? 0.72 : ([CONFIGURATION.nailongSize] == &quot;xl&quot; ? 0.84 : ([CONFIGURATION.nailongSize] == &quot;large&quot; ? 0.92 : 1.0)))))">
                            <Animation duration="1.3" interpolation="LINEAR" fps="30" />
                        </Transform>
                        <Transform target="y" value="165 + (([ACCELEROMETER_ANGLE_X] &gt; 25 || [ACCELEROMETER_ANGLE_X] &lt; -25 || [ACCELEROMETER_ANGLE_Y] &gt; 25 || [ACCELEROMETER_ANGLE_Y] &lt; -25) ? (([ACCELEROMETER_ANGLE_Y] &gt; 25 ? 1 : ([ACCELEROMETER_ANGLE_Y] &lt; -25 ? -1 : 0)) * ((([ACCELEROMETER_ANGLE_X] &gt; 25 || [ACCELEROMETER_ANGLE_X] &lt; -25) &amp;&amp; ([ACCELEROMETER_ANGLE_Y] &gt; 25 || [ACCELEROMETER_ANGLE_Y] &lt; -25)) ? ([CONFIGURATION.nailongSize] == &quot;small&quot; ? 107 : ([CONFIGURATION.nailongSize] == &quot;medium&quot; ? 102 : ([CONFIGURATION.nailongSize] == &quot;large&quot; ? 92 : ([CONFIGURATION.nailongSize] == &quot;xl&quot; ? 82 : 72)))) : ([CONFIGURATION.nailongSize] == &quot;small&quot; ? 152 : ([CONFIGURATION.nailongSize] == &quot;medium&quot; ? 144 : ([CONFIGURATION.nailongSize] == &quot;large&quot; ? 130 : ([CONFIGURATION.nailongSize] == &quot;xl&quot; ? 116 : 102)))))) : (([CONFIGURATION.nailongHome] == &quot;bottom&quot; ? 142 : ([CONFIGURATION.nailongHome] == &quot;center&quot; ? 0 : -114)) * ([CONFIGURATION.nailongSize] == &quot;giant&quot; ? 0.72 : ([CONFIGURATION.nailongSize] == &quot;xl&quot; ? 0.84 : ([CONFIGURATION.nailongSize] == &quot;large&quot; ? 0.92 : 1.0)))))">
                            <Animation duration="1.3" interpolation="LINEAR" fps="30" />
                        </Transform>
                        <Transform target="angle" value="([ACCELEROMETER_ANGLE_X] &gt; 25 ? 8 : ([ACCELEROMETER_ANGLE_X] &lt; -25 ? -8 : 0))">
                            <Animation duration="0.35" interpolation="EASE_OUT" fps="30" />
                        </Transform>
                        <Transform target="scaleX" value="([CONFIGURATION.nailongSize] == &quot;small&quot; ? 0.85 : ([CONFIGURATION.nailongSize] == &quot;medium&quot; ? 1.0 : ([CONFIGURATION.nailongSize] == &quot;large&quot; ? 1.35 : ([CONFIGURATION.nailongSize] == &quot;xl&quot; ? 1.65 : ([CONFIGURATION.nailongSize] == &quot;off&quot; ? 0.0 : 2.0)))))" />
                        <Transform target="scaleY" value="([CONFIGURATION.nailongSize] == &quot;small&quot; ? 0.85 : ([CONFIGURATION.nailongSize] == &quot;medium&quot; ? 1.0 : ([CONFIGURATION.nailongSize] == &quot;large&quot; ? 1.35 : ([CONFIGURATION.nailongSize] == &quot;xl&quot; ? 1.65 : ([CONFIGURATION.nailongSize] == &quot;off&quot; ? 0.0 : 2.0)))))" />

                        <!-- Nailong sprite (crisp 192x192 source, dynamically scaled 0.85x..2.0x) -->
                        <Condition>
                            <Expressions>
                                <Expression name="steepTopRightFront"><![CDATA[([ACCELEROMETER_ANGLE_X] > 25 && [ACCELEROMETER_ANGLE_Y] < -25)]]></Expression>
                                <Expression name="steepTopLeftFront"><![CDATA[([ACCELEROMETER_ANGLE_X] < -25 && [ACCELEROMETER_ANGLE_Y] < -25)]]></Expression>
                                <Expression name="runRightFront"><![CDATA[([ACCELEROMETER_ANGLE_X] > 25 || [ACCELEROMETER_ANGLE_Y] > 25 || [ACCELEROMETER_ANGLE_Y] < -25)]]></Expression>
                                <Expression name="runLeftFront"><![CDATA[[ACCELEROMETER_ANGLE_X] < -25]]></Expression>
                                <Expression name="holdNotifFlatFront"><![CDATA[[UNREAD_NOTIFICATION_COUNT] > 0]]></Expression>
                            </Expressions>

                            <Compare expression="steepTopRightFront">
                                <PartAnimatedImage x="14" y="14" width="92" height="92" name="nlFrontTopRight">
                                    <AnimationController play="ON_VISIBLE" repeat="TRUE" />
                                    <AnimatedImage resource="nailong_top_right_anim" format="WEBP" thumbnail="nailong_top_right_thumb" />
                                    <Thumbnail resource="nailong_top_right_thumb" />
                                </PartAnimatedImage>
                            </Compare>

                            <Compare expression="steepTopLeftFront">
                                <PartAnimatedImage x="14" y="14" width="92" height="92" name="nlFrontTopLeft">
                                    <AnimationController play="ON_VISIBLE" repeat="TRUE" />
                                    <AnimatedImage resource="nailong_top_left_anim" format="WEBP" thumbnail="nailong_top_left_thumb" />
                                    <Thumbnail resource="nailong_top_left_thumb" />
                                </PartAnimatedImage>
                            </Compare>

                            <Compare expression="runLeftFront">
                                <PartAnimatedImage x="14" y="14" width="92" height="92" name="nlFrontRunLeft">
                                    <AnimationController play="ON_VISIBLE" repeat="TRUE" />
                                    <AnimatedImage resource="nailong_run_left_anim" format="WEBP" thumbnail="nailong_run_left_thumb" />
                                    <Thumbnail resource="nailong_run_left_thumb" />
                                </PartAnimatedImage>
                            </Compare>

                            <Compare expression="runRightFront">
                                <PartAnimatedImage x="14" y="14" width="92" height="92" name="nlFrontRunRight">
                                    <AnimationController play="ON_VISIBLE" repeat="TRUE" />
                                    <AnimatedImage resource="nailong_run_right_anim" format="WEBP" thumbnail="nailong_run_right_thumb" />
                                    <Thumbnail resource="nailong_run_right_thumb" />
                                </PartAnimatedImage>
                            </Compare>

                            <Compare expression="holdNotifFlatFront">
                                <PartAnimatedImage x="14" y="14" width="92" height="92" name="nlFrontHoldNotif">
                                    <AnimationController play="ON_VISIBLE" repeat="TRUE" delayRepeat="0.8" />
                                    <AnimatedImage resource="nailong_wave_anim" format="WEBP" thumbnail="nailong_wave_thumb" />
                                    <Thumbnail resource="nailong_wave_thumb" />
                                </PartAnimatedImage>
                            </Compare>

                            <Default>
                                <PartAnimatedImage x="14" y="14" width="92" height="92" name="nlFrontIdle">
                                    <AnimationController play="ON_VISIBLE TAP" repeat="TRUE" delayRepeat="0.3" />
                                    <AnimatedImages change="TAP">
                                        <AnimatedImage resource="nailong_idle_anim" format="WEBP" thumbnail="nailong_idle_thumb" />
                                        <AnimatedImage resource="nailong_check_anim" format="WEBP" thumbnail="nailong_check_thumb" />
                                        <AnimatedImage resource="nailong_wave_anim" format="WEBP" thumbnail="nailong_wave_thumb" />
                                        <AnimatedImage resource="nailong_think_anim" format="WEBP" thumbnail="nailong_think_thumb" />
                                    </AnimatedImages>
                                    <Thumbnail resource="nailong_idle_thumb" />
                                </PartAnimatedImage>
                            </Default>
                        </Condition>

                        <!-- Style-aligned notification badge (counter-scaled cleanly across all Nailong sizes) -->
                        <Condition>
                            <Expressions>
                                <Expression name="hasNotifFront"><![CDATA[[UNREAD_NOTIFICATION_COUNT] > 0]]></Expression>
                            </Expressions>
                            <Compare expression="hasNotifFront">
                                <Group name="nlFrontNotifBadge" x="6" y="22" width="30" height="30" pivotX="0.5" pivotY="0.5">
                                    <Transform target="x" value="([ACCELEROMETER_ANGLE_X] &gt; 25 ? 84 : 6)">
                                        <Animation duration="0.25" interpolation="EASE_OUT" fps="30" />
                                    </Transform>
                                    <Transform target="y" value="(([ACCELEROMETER_ANGLE_Y] &lt; -25 &amp;&amp; ([ACCELEROMETER_ANGLE_X] &gt; 25 || [ACCELEROMETER_ANGLE_X] &lt; -25)) ? 14 : (([ACCELEROMETER_ANGLE_X] &gt; 25 || [ACCELEROMETER_ANGLE_X] &lt; -25 || [ACCELEROMETER_ANGLE_Y] &gt; 25 || [ACCELEROMETER_ANGLE_Y] &lt; -25) ? 28 : 22))">
                                        <Animation duration="0.25" interpolation="EASE_OUT" fps="30" />
                                    </Transform>
                                    <Transform target="scaleX" value="([CONFIGURATION.nailongSize] == &quot;giant&quot; ? 0.62 : ([CONFIGURATION.nailongSize] == &quot;xl&quot; ? 0.72 : ([CONFIGURATION.nailongSize] == &quot;large&quot; ? 0.85 : 1.0)))" />
                                    <Transform target="scaleY" value="([CONFIGURATION.nailongSize] == &quot;giant&quot; ? 0.62 : ([CONFIGURATION.nailongSize] == &quot;xl&quot; ? 0.72 : ([CONFIGURATION.nailongSize] == &quot;large&quot; ? 0.85 : 1.0)))" />
                                    <PartDraw x="0" y="0" width="30" height="30">
                                        <Ellipse x="2" y="2" width="26" height="26">
                                            <Fill color="#F21C2110" />
                                        </Ellipse>
                                        <Ellipse x="2" y="2" width="26" height="26">
                                            <Stroke color="#FFE8F553" thickness="2.6" />
                                        </Ellipse>
                                    </PartDraw>
                                    <Condition>
                                        <Expressions>
                                            <Expression name="notifOver99Front"><![CDATA[[UNREAD_NOTIFICATION_COUNT] > 99]]></Expression>
                                        </Expressions>
                                        <Compare expression="notifOver99Front">
                                            <PartText x="1" y="7" width="28" height="18">
                                                <Text align="CENTER" maxLines="1">
                                                    <Font family="utility_bold" size="11" weight="BOLD" color="#FFFFFFFF">99+</Font>
                                                </Text>
                                            </PartText>
                                        </Compare>
                                        <Default>
                                            <PartText x="1" y="4" width="28" height="22">
                                                <Text align="CENTER" maxLines="1">
                                                    <Font family="utility_bold" size="15" weight="BOLD" color="#FFFFFFFF">
                                                        <Template><![CDATA[%d]]><Parameter expression="[UNREAD_NOTIFICATION_COUNT]" /></Template>
                                                    </Font>
                                                </Text>
                                            </PartText>
                                        </Default>
                                    </Condition>
                                </Group>
                            </Compare>
                        </Condition>
                    </Group>
                </Group>
            </ListOption>
        </ListConfiguration>

    </Scene>

</WatchFace>
