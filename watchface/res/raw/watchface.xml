<?xml version="1.0" encoding="utf-8"?>
<!--
  Nailong Pixel Watch Face — Design v4 (WFF v2)
  - Pixel Watch layout: uppercase date, bold 24h clock (#E8F553),
    and 3 circular metric widgets (Steps, Battery, Heart Rate)
  - Style-aligned olive+lime notification count badge (capped at 99+) held in Nailong's paw
    whenever [UNREAD_NOTIFICATION_COUNT] > 0 (carried smoothly while tilting!)
  - Full-face smooth tilt-wandering Nailong (92x92; <Transform> + EASE_OUT 30fps <Animation>)
    with exact circular boundary clamping (R=144px, guaranteed inside round bezel)
  - 5 tilt states: Flat Idle + Tap reactions (Idle/Check/Wave/Think),
    Run Left/Right (>12 deg), Steep Top-Left/Top-Right (>30 deg)
  - Watch Face Editor customization: Layer (Behind/Front), Home position, Size
-->
<WatchFace width="450" height="450">

    <Metadata key="PREVIEW_TIME" value="22:55:00" />
    <Metadata key="CLOCK_TYPE" value="DIGITAL" />

    <UserConfigurations>
        <ListConfiguration id="nailongLayer" displayName="config_layer_name" defaultValue="behind">
            <ListOption id="behind" displayName="config_layer_behind" />
            <ListOption id="front" displayName="config_layer_front" />
        </ListConfiguration>

        <ListConfiguration id="nailongHome" displayName="config_home_name" defaultValue="top_right">
            <ListOption id="top_right" displayName="config_home_top_right" />
            <ListOption id="center" displayName="config_home_center" />
            <ListOption id="top_left" displayName="config_home_top_left" />
            <ListOption id="bottom" displayName="config_home_bottom" />
        </ListConfiguration>

        <ListConfiguration id="nailongSize" displayName="config_size_name" defaultValue="medium">
            <ListOption id="small" displayName="config_size_small" />
            <ListOption id="medium" displayName="config_size_medium" />
            <ListOption id="large" displayName="config_size_large" />
            <ListOption id="off" displayName="config_size_off" />
        </ListConfiguration>
    </UserConfigurations>

    <Scene backgroundColor="#FF000000">

        <!-- ============================================================ -->
        <!-- NAILONG LAYER: BEHIND CLOCK (Default)                        -->
        <!-- ============================================================ -->
        <ListConfiguration id="nailongLayer">
            <ListOption id="behind">
                <Group name="nailongBehindRoot" x="0" y="0" width="450" height="450">
                    <Variant mode="AMBIENT" target="alpha" value="0" />

                    <Group name="nailongBehindMover" x="283" y="59" width="120" height="120" pivotX="0.5" pivotY="0.5">
                        <Transform target="x" value="165 + (([CONFIGURATION.nailongHome] == &quot;top_right&quot; ? 118 : ([CONFIGURATION.nailongHome] == &quot;top_left&quot; ? -118 : 0)) * (1 - clamp(sqrt([ACCELEROMETER_ANGLE_X] * [ACCELEROMETER_ANGLE_X] + [ACCELEROMETER_ANGLE_Y] * [ACCELEROMETER_ANGLE_Y]) / 22, 0, 1)) - [ACCELEROMETER_ANGLE_X] * 3.8) * (sqrt((([CONFIGURATION.nailongHome] == &quot;top_right&quot; ? 118 : ([CONFIGURATION.nailongHome] == &quot;top_left&quot; ? -118 : 0)) * (1 - clamp(sqrt([ACCELEROMETER_ANGLE_X] * [ACCELEROMETER_ANGLE_X] + [ACCELEROMETER_ANGLE_Y] * [ACCELEROMETER_ANGLE_Y]) / 22, 0, 1)) - [ACCELEROMETER_ANGLE_X] * 3.8) * (([CONFIGURATION.nailongHome] == &quot;top_right&quot; ? 118 : ([CONFIGURATION.nailongHome] == &quot;top_left&quot; ? -118 : 0)) * (1 - clamp(sqrt([ACCELEROMETER_ANGLE_X] * [ACCELEROMETER_ANGLE_X] + [ACCELEROMETER_ANGLE_Y] * [ACCELEROMETER_ANGLE_Y]) / 22, 0, 1)) - [ACCELEROMETER_ANGLE_X] * 3.8) + (([CONFIGURATION.nailongHome] == &quot;bottom&quot; ? 138 : ([CONFIGURATION.nailongHome] == &quot;center&quot; ? 0 : -106)) * (1 - clamp(sqrt([ACCELEROMETER_ANGLE_X] * [ACCELEROMETER_ANGLE_X] + [ACCELEROMETER_ANGLE_Y] * [ACCELEROMETER_ANGLE_Y]) / 22, 0, 1)) + [ACCELEROMETER_ANGLE_Y] * 3.8) * (([CONFIGURATION.nailongHome] == &quot;bottom&quot; ? 138 : ([CONFIGURATION.nailongHome] == &quot;center&quot; ? 0 : -106)) * (1 - clamp(sqrt([ACCELEROMETER_ANGLE_X] * [ACCELEROMETER_ANGLE_X] + [ACCELEROMETER_ANGLE_Y] * [ACCELEROMETER_ANGLE_Y]) / 22, 0, 1)) + [ACCELEROMETER_ANGLE_Y] * 3.8)) &gt; 144 ? 144 / sqrt((([CONFIGURATION.nailongHome] == &quot;top_right&quot; ? 118 : ([CONFIGURATION.nailongHome] == &quot;top_left&quot; ? -118 : 0)) * (1 - clamp(sqrt([ACCELEROMETER_ANGLE_X] * [ACCELEROMETER_ANGLE_X] + [ACCELEROMETER_ANGLE_Y] * [ACCELEROMETER_ANGLE_Y]) / 22, 0, 1)) - [ACCELEROMETER_ANGLE_X] * 3.8) * (([CONFIGURATION.nailongHome] == &quot;top_right&quot; ? 118 : ([CONFIGURATION.nailongHome] == &quot;top_left&quot; ? -118 : 0)) * (1 - clamp(sqrt([ACCELEROMETER_ANGLE_X] * [ACCELEROMETER_ANGLE_X] + [ACCELEROMETER_ANGLE_Y] * [ACCELEROMETER_ANGLE_Y]) / 22, 0, 1)) - [ACCELEROMETER_ANGLE_X] * 3.8) + (([CONFIGURATION.nailongHome] == &quot;bottom&quot; ? 138 : ([CONFIGURATION.nailongHome] == &quot;center&quot; ? 0 : -106)) * (1 - clamp(sqrt([ACCELEROMETER_ANGLE_X] * [ACCELEROMETER_ANGLE_X] + [ACCELEROMETER_ANGLE_Y] * [ACCELEROMETER_ANGLE_Y]) / 22, 0, 1)) + [ACCELEROMETER_ANGLE_Y] * 3.8) * (([CONFIGURATION.nailongHome] == &quot;bottom&quot; ? 138 : ([CONFIGURATION.nailongHome] == &quot;center&quot; ? 0 : -106)) * (1 - clamp(sqrt([ACCELEROMETER_ANGLE_X] * [ACCELEROMETER_ANGLE_X] + [ACCELEROMETER_ANGLE_Y] * [ACCELEROMETER_ANGLE_Y]) / 22, 0, 1)) + [ACCELEROMETER_ANGLE_Y] * 3.8)) : 1)">
                            <Animation duration="0.35" interpolation="EASE_OUT" fps="30" />
                        </Transform>
                        <Transform target="y" value="165 + (([CONFIGURATION.nailongHome] == &quot;bottom&quot; ? 138 : ([CONFIGURATION.nailongHome] == &quot;center&quot; ? 0 : -106)) * (1 - clamp(sqrt([ACCELEROMETER_ANGLE_X] * [ACCELEROMETER_ANGLE_X] + [ACCELEROMETER_ANGLE_Y] * [ACCELEROMETER_ANGLE_Y]) / 22, 0, 1)) + [ACCELEROMETER_ANGLE_Y] * 3.8) * (sqrt((([CONFIGURATION.nailongHome] == &quot;top_right&quot; ? 118 : ([CONFIGURATION.nailongHome] == &quot;top_left&quot; ? -118 : 0)) * (1 - clamp(sqrt([ACCELEROMETER_ANGLE_X] * [ACCELEROMETER_ANGLE_X] + [ACCELEROMETER_ANGLE_Y] * [ACCELEROMETER_ANGLE_Y]) / 22, 0, 1)) - [ACCELEROMETER_ANGLE_X] * 3.8) * (([CONFIGURATION.nailongHome] == &quot;top_right&quot; ? 118 : ([CONFIGURATION.nailongHome] == &quot;top_left&quot; ? -118 : 0)) * (1 - clamp(sqrt([ACCELEROMETER_ANGLE_X] * [ACCELEROMETER_ANGLE_X] + [ACCELEROMETER_ANGLE_Y] * [ACCELEROMETER_ANGLE_Y]) / 22, 0, 1)) - [ACCELEROMETER_ANGLE_X] * 3.8) + (([CONFIGURATION.nailongHome] == &quot;bottom&quot; ? 138 : ([CONFIGURATION.nailongHome] == &quot;center&quot; ? 0 : -106)) * (1 - clamp(sqrt([ACCELEROMETER_ANGLE_X] * [ACCELEROMETER_ANGLE_X] + [ACCELEROMETER_ANGLE_Y] * [ACCELEROMETER_ANGLE_Y]) / 22, 0, 1)) + [ACCELEROMETER_ANGLE_Y] * 3.8) * (([CONFIGURATION.nailongHome] == &quot;bottom&quot; ? 138 : ([CONFIGURATION.nailongHome] == &quot;center&quot; ? 0 : -106)) * (1 - clamp(sqrt([ACCELEROMETER_ANGLE_X] * [ACCELEROMETER_ANGLE_X] + [ACCELEROMETER_ANGLE_Y] * [ACCELEROMETER_ANGLE_Y]) / 22, 0, 1)) + [ACCELEROMETER_ANGLE_Y] * 3.8)) &gt; 144 ? 144 / sqrt((([CONFIGURATION.nailongHome] == &quot;top_right&quot; ? 118 : ([CONFIGURATION.nailongHome] == &quot;top_left&quot; ? -118 : 0)) * (1 - clamp(sqrt([ACCELEROMETER_ANGLE_X] * [ACCELEROMETER_ANGLE_X] + [ACCELEROMETER_ANGLE_Y] * [ACCELEROMETER_ANGLE_Y]) / 22, 0, 1)) - [ACCELEROMETER_ANGLE_X] * 3.8) * (([CONFIGURATION.nailongHome] == &quot;top_right&quot; ? 118 : ([CONFIGURATION.nailongHome] == &quot;top_left&quot; ? -118 : 0)) * (1 - clamp(sqrt([ACCELEROMETER_ANGLE_X] * [ACCELEROMETER_ANGLE_X] + [ACCELEROMETER_ANGLE_Y] * [ACCELEROMETER_ANGLE_Y]) / 22, 0, 1)) - [ACCELEROMETER_ANGLE_X] * 3.8) + (([CONFIGURATION.nailongHome] == &quot;bottom&quot; ? 138 : ([CONFIGURATION.nailongHome] == &quot;center&quot; ? 0 : -106)) * (1 - clamp(sqrt([ACCELEROMETER_ANGLE_X] * [ACCELEROMETER_ANGLE_X] + [ACCELEROMETER_ANGLE_Y] * [ACCELEROMETER_ANGLE_Y]) / 22, 0, 1)) + [ACCELEROMETER_ANGLE_Y] * 3.8) * (([CONFIGURATION.nailongHome] == &quot;bottom&quot; ? 138 : ([CONFIGURATION.nailongHome] == &quot;center&quot; ? 0 : -106)) * (1 - clamp(sqrt([ACCELEROMETER_ANGLE_X] * [ACCELEROMETER_ANGLE_X] + [ACCELEROMETER_ANGLE_Y] * [ACCELEROMETER_ANGLE_Y]) / 22, 0, 1)) + [ACCELEROMETER_ANGLE_Y] * 3.8)) : 1)">
                            <Animation duration="0.35" interpolation="EASE_OUT" fps="30" />
                        </Transform>
                        <Transform target="angle" value="clamp(-[ACCELEROMETER_ANGLE_X] * 0.22, -12, 12)">
                            <Animation duration="0.3" interpolation="EASE_OUT" fps="30" />
                        </Transform>
                        <Transform target="scaleX" value="[CONFIGURATION.nailongSize] == &quot;small&quot; ? 0.84 : ([CONFIGURATION.nailongSize] == &quot;large&quot; ? 1.12 : ([CONFIGURATION.nailongSize] == &quot;off&quot; ? 0.0 : 1.0))" />
                        <Transform target="scaleY" value="[CONFIGURATION.nailongSize] == &quot;small&quot; ? 0.84 : ([CONFIGURATION.nailongSize] == &quot;large&quot; ? 1.12 : ([CONFIGURATION.nailongSize] == &quot;off&quot; ? 0.0 : 1.0))" />

                        <!-- Nailong sprite (92x92; 5 directional tilt states + holding pose when unread > 0) -->
                        <Condition>
                            <Expressions>
                                <Expression name="steepTopRightBehind"><![CDATA[([ACCELEROMETER_ANGLE_X] < -15 && [ACCELEROMETER_ANGLE_Y] < -15 && ([ACCELEROMETER_ANGLE_X] * [ACCELEROMETER_ANGLE_X] + [ACCELEROMETER_ANGLE_Y] * [ACCELEROMETER_ANGLE_Y]) >= 900)]]></Expression>
                                <Expression name="steepTopLeftBehind"><![CDATA[([ACCELEROMETER_ANGLE_X] > 15 && [ACCELEROMETER_ANGLE_Y] < -15 && ([ACCELEROMETER_ANGLE_X] * [ACCELEROMETER_ANGLE_X] + [ACCELEROMETER_ANGLE_Y] * [ACCELEROMETER_ANGLE_Y]) >= 900)]]></Expression>
                                <Expression name="runRightBehind"><![CDATA[[ACCELEROMETER_ANGLE_X] < -12]]></Expression>
                                <Expression name="runLeftBehind"><![CDATA[[ACCELEROMETER_ANGLE_X] > 12]]></Expression>
                                <Expression name="holdNotifFlatBehind"><![CDATA[[UNREAD_NOTIFICATION_COUNT] > 0]]></Expression>
                            </Expressions>

                            <Compare expression="steepTopRightBehind">
                                <PartAnimatedImage x="14" y="14" width="92" height="92" name="nlBehindTopRight">
                                    <AnimationController play="ON_VISIBLE" repeat="TRUE" />
                                    <AnimatedImage resource="nailong_top_right_anim" format="WEBP" thumbnail="nailong_top_right_thumb" />
                                    <Thumbnail resource="nailong_top_right_thumb" />
                                </PartAnimatedImage>
                            </Compare>

                            <Compare expression="steepTopLeftBehind">
                                <PartAnimatedImage x="14" y="14" width="92" height="92" name="nlBehindTopLeft">
                                    <AnimationController play="ON_VISIBLE" repeat="TRUE" />
                                    <AnimatedImage resource="nailong_top_left_anim" format="WEBP" thumbnail="nailong_top_left_thumb" />
                                    <Thumbnail resource="nailong_top_left_thumb" />
                                </PartAnimatedImage>
                            </Compare>

                            <Compare expression="runRightBehind">
                                <PartAnimatedImage x="14" y="14" width="92" height="92" name="nlBehindRunRight">
                                    <AnimationController play="ON_VISIBLE" repeat="TRUE" />
                                    <AnimatedImage resource="nailong_run_right_anim" format="WEBP" thumbnail="nailong_run_right_thumb" />
                                    <Thumbnail resource="nailong_run_right_thumb" />
                                </PartAnimatedImage>
                            </Compare>

                            <Compare expression="runLeftBehind">
                                <PartAnimatedImage x="14" y="14" width="92" height="92" name="nlBehindRunLeft">
                                    <AnimationController play="ON_VISIBLE" repeat="TRUE" />
                                    <AnimatedImage resource="nailong_run_left_anim" format="WEBP" thumbnail="nailong_run_left_thumb" />
                                    <Thumbnail resource="nailong_run_left_thumb" />
                                </PartAnimatedImage>
                            </Compare>

                            <Compare expression="holdNotifFlatBehind">
                                <PartAnimatedImage x="14" y="14" width="92" height="92" name="nlBehindHoldNotif">
                                    <AnimationController play="ON_VISIBLE" repeat="TRUE" delayRepeat="0.8" />
                                    <AnimatedImage resource="nailong_wave_anim" format="WEBP" thumbnail="nailong_wave_thumb" />
                                    <Thumbnail resource="nailong_wave_thumb" />
                                </PartAnimatedImage>
                            </Compare>

                            <Default>
                                <PartAnimatedImage x="14" y="14" width="92" height="92" name="nlBehindIdle">
                                    <AnimationController play="ON_VISIBLE TAP" repeat="TRUE" delayRepeat="0.3" />
                                    <AnimatedImages change="TAP">
                                        <AnimatedImage resource="nailong_idle_anim" format="WEBP" thumbnail="nailong_idle_thumb" />
                                        <AnimatedImage resource="nailong_check_anim" format="WEBP" thumbnail="nailong_check_thumb" />
                                        <AnimatedImage resource="nailong_wave_anim" format="WEBP" thumbnail="nailong_wave_thumb" />
                                        <AnimatedImage resource="nailong_think_anim" format="WEBP" thumbnail="nailong_think_thumb" />
                                    </AnimatedImages>
                                    <Thumbnail resource="nailong_idle_thumb" />
                                </PartAnimatedImage>
                            </Default>
                        </Condition>

                        <!-- Style-aligned notification badge held in Nailong's paw whenever unread > 0 -->
                        <Condition>
                            <Expressions>
                                <Expression name="hasNotifBehind"><![CDATA[[UNREAD_NOTIFICATION_COUNT] > 0]]></Expression>
                            </Expressions>
                            <Compare expression="hasNotifBehind">
                                <Group name="nlBehindNotifBadge" x="0" y="22" width="30" height="30">
                                    <Transform target="x" value="([ACCELEROMETER_ANGLE_X] &lt; -12 ? 88 : 0)">
                                        <Animation duration="0.22" interpolation="EASE_OUT" fps="30" />
                                    </Transform>
                                    <Transform target="y" value="(([ACCELEROMETER_ANGLE_Y] &lt; -15 &amp;&amp; ([ACCELEROMETER_ANGLE_X] * [ACCELEROMETER_ANGLE_X] + [ACCELEROMETER_ANGLE_Y] * [ACCELEROMETER_ANGLE_Y]) &gt;= 900) ? 12 : ([ACCELEROMETER_ANGLE_X] &lt; -12 || [ACCELEROMETER_ANGLE_X] &gt; 12 ? 26 : 22))">
                                        <Animation duration="0.22" interpolation="EASE_OUT" fps="30" />
                                    </Transform>
                                    <PartDraw x="0" y="0" width="30" height="30">
                                        <Ellipse x="2" y="2" width="26" height="26">
                                            <Fill color="#F21C2110" />
                                        </Ellipse>
                                        <Ellipse x="2" y="2" width="26" height="26">
                                            <Stroke color="#FFE8F553" thickness="2.6" />
                                        </Ellipse>
                                    </PartDraw>
                                    <Condition>
                                        <Expressions>
                                            <Expression name="notifOver99Behind"><![CDATA[[UNREAD_NOTIFICATION_COUNT] > 99]]></Expression>
                                        </Expressions>
                                        <Compare expression="notifOver99Behind">
                                            <PartText x="1" y="7" width="28" height="18">
                                                <Text align="CENTER" maxLines="1">
                                                    <Font family="SYNC_TO_DEVICE" size="11" weight="BOLD" color="#FFFFFFFF">99+</Font>
                                                </Text>
                                            </PartText>
                                        </Compare>
                                        <Default>
                                            <PartText x="1" y="4" width="28" height="22">
                                                <Text align="CENTER" maxLines="1">
                                                    <Font family="SYNC_TO_DEVICE" size="15" weight="BOLD" color="#FFFFFFFF">
                                                        <Template><![CDATA[%d]]><Parameter expression="[UNREAD_NOTIFICATION_COUNT]" /></Template>
                                                    </Font>
                                                </Text>
                                            </PartText>
                                        </Default>
                                    </Condition>
                                </Group>
                            </Compare>
                        </Condition>
                    </Group>
                </Group>
            </ListOption>
        </ListConfiguration>

        <!-- ============================================================ -->
        <!-- DATE HEADER: "WED" (#E8F553) + "NOV 25" (#FFFFFF)            -->
        <!-- ============================================================ -->
        <PartText x="55" y="70" width="340" height="34" name="dateHeader">
            <Variant mode="AMBIENT" target="alpha" value="145" />
            <Text align="CENTER">
                <Font family="SYNC_TO_DEVICE" size="21" weight="BOLD" color="#FFE8F553">
                    <Upper>
                        <Template><![CDATA[%s ]]><Parameter expression="[DAY_OF_WEEK_S]" /></Template>
                    </Upper>
                </Font>
                <Font family="SYNC_TO_DEVICE" size="21" weight="BOLD" color="#FFFFFFFF">
                    <Upper>
                        <Template><![CDATA[%s %d]]><Parameter expression="[MONTH_S]" /><Parameter expression="[DAY]" /></Template>
                    </Upper>
                </Font>
            </Text>
        </PartText>

        <!-- ============================================================ -->
        <!-- 24-HOUR DIGITAL CLOCK: Bold horizontal "22:55"               -->
        <!-- ============================================================ -->
        <DigitalClock x="30" y="124" width="390" height="112">
            <TimeText format="hh:mm" hourFormat="24" align="CENTER" x="0" y="0" width="390" height="112">
                <Variant mode="AMBIENT" target="alpha" value="145" />
                <Font family="SYNC_TO_DEVICE" size="90" weight="BOLD" color="#FFE8F553" />
            </TimeText>
        </DigitalClock>

        <!-- ============================================================ -->
        <!-- THREE CIRCULAR METRIC WIDGETS (Steps | Battery | Heart Rate) -->
        <!-- ============================================================ -->
        <Group name="metricsRow" x="0" y="258" width="450" height="104">
            <Variant mode="AMBIENT" target="alpha" value="0" />

            <!-- 1. STEPS CIRCLE (Left) -->
            <Group name="stepsWidget" x="68" y="4" width="92" height="92">
                <PartDraw x="0" y="0" width="92" height="92">
                    <Ellipse x="0" y="0" width="92" height="92">
                        <Fill color="#CC242814" />
                    </Ellipse>
                    <Arc centerX="46" centerY="46" width="84" height="84" startAngle="-145" endAngle="145" direction="CLOCKWISE">
                        <Stroke color="#FF3B421D" thickness="6.5" cap="ROUND" />
                    </Arc>
                    <Arc centerX="46" centerY="46" width="84" height="84" startAngle="-145" endAngle="-145" direction="CLOCKWISE">
                        <Transform target="endAngle" value="-145 + clamp([STEP_PERCENT], 0, 100) * 2.9">
                            <Animation duration="0.4" interpolation="EASE_OUT" />
                        </Transform>
                        <Stroke color="#FFE8F553" thickness="6.5" cap="ROUND" />
                    </Arc>
                </PartDraw>
                <PartText x="8" y="29" width="76" height="30">
                    <Text align="CENTER" maxLines="1">
                        <Font family="SYNC_TO_DEVICE" size="19" weight="BOLD" color="#FFFFFFFF">
                            <Template><![CDATA[%d]]><Parameter expression="[STEP_COUNT]" /></Template>
                        </Font>
                    </Text>
                </PartText>
                <PartImage x="36" y="70" width="20" height="20">
                    <Image resource="ic_steps" />
                </PartImage>
            </Group>

            <!-- 2. BATTERY CIRCLE (Center) -->
            <Group name="batteryWidget" x="179" y="4" width="92" height="92">
                <PartDraw x="0" y="0" width="92" height="92">
                    <Ellipse x="0" y="0" width="92" height="92">
                        <Fill color="#CC242814" />
                    </Ellipse>
                    <Arc centerX="46" centerY="46" width="84" height="84" startAngle="-145" endAngle="145" direction="CLOCKWISE">
                        <Stroke color="#FF3B421D" thickness="6.5" cap="ROUND" />
                    </Arc>
                    <Arc centerX="46" centerY="46" width="84" height="84" startAngle="-145" endAngle="-145" direction="CLOCKWISE">
                        <Transform target="endAngle" value="-145 + clamp([BATTERY_PERCENT], 0, 100) * 2.9">
                            <Animation duration="0.4" interpolation="EASE_OUT" />
                        </Transform>
                        <Stroke color="#FFE8F553" thickness="6.5" cap="ROUND" />
                    </Arc>
                </PartDraw>
                <PartText x="10" y="29" width="72" height="30">
                    <Text align="CENTER" maxLines="1">
                        <Font family="SYNC_TO_DEVICE" size="21" weight="BOLD" color="#FFFFFFFF">
                            <Template><![CDATA[%d]]><Parameter expression="[BATTERY_PERCENT]" /></Template>
                        </Font>
                    </Text>
                </PartText>
                <PartImage x="37" y="70" width="18" height="18">
                    <Image resource="ic_battery" />
                </PartImage>
            </Group>

            <!-- 3. HEART RATE CIRCLE (Right) -->
            <Group name="heartRateWidget" x="290" y="4" width="92" height="92">
                <PartDraw x="0" y="0" width="92" height="92">
                    <Ellipse x="0" y="0" width="92" height="92">
                        <Fill color="#CC242814" />
                    </Ellipse>
                </PartDraw>
                <PartImage x="35" y="18" width="22" height="22">
                    <Image resource="ic_heart" />
                </PartImage>
                <Condition>
                    <Expressions>
                        <Expression name="hasHr"><![CDATA[[HEART_RATE] > 0]]></Expression>
                    </Expressions>
                    <Compare expression="hasHr">
                        <PartText x="8" y="46" width="76" height="32">
                            <Text align="CENTER" maxLines="1">
                                <Font family="SYNC_TO_DEVICE" size="22" weight="BOLD" color="#FFFFFFFF">
                                    <Template><![CDATA[%d]]><Parameter expression="round([HEART_RATE])" /></Template>
                                </Font>
                            </Text>
                        </PartText>
                    </Compare>
                    <Default>
                        <PartText x="8" y="46" width="76" height="32">
                            <Text align="CENTER" maxLines="1">
                                <Font family="SYNC_TO_DEVICE" size="22" weight="BOLD" color="#FFFFFFFF">--</Font>
                            </Text>
                        </PartText>
                    </Default>
                </Condition>
            </Group>
        </Group>

        <!-- ============================================================ -->
        <!-- NAILONG LAYER: IN FRONT OF CLOCK (Optional Customize Toggle) -->
        <!-- ============================================================ -->
        <ListConfiguration id="nailongLayer">
            <ListOption id="front">
                <Group name="nailongFrontRoot" x="0" y="0" width="450" height="450">
                    <Variant mode="AMBIENT" target="alpha" value="0" />

                    <Group name="nailongFrontMover" x="283" y="59" width="120" height="120" pivotX="0.5" pivotY="0.5">
